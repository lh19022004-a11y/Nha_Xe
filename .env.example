# SMTP connection (for Gmail, use an app password; do not use your normal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-email-app-password

# The mailbox that should receive booking requests
MAIL_TO=your-booking-inbox@example.com
MAIL_FROM=your-sending-address@gmail.com
